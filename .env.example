# FormCraft AI Environment Variables Reference
# Set these variables in your deployment dashboard (e.g. Vercel Settings -> Environment Variables)
# Note: Client-side variables in Vite must be prefixed with VITE_

# Firebase Authentication & Applet Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

